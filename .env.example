# KI.AI Production & Development Environment Configuration

# Razorpay Payment Credentials (India SaaS Default)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Payment Mode: 'test' for simulation and local sandbox, 'live' for production
PAYMENT_MODE=test

# Application Host & Security
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081,http://127.0.0.1:8080,http://127.0.0.1:8081
SECRET_KEY=ki_ai_production_secret_key_change_in_live

# Optional Demo Mode override
KI_AI_DEMO_MODE=true

# Google OAuth 2.0 Credentials (Get from Google Cloud Console)
# 1. Create Web Application client at https://console.cloud.google.com/apis/credentials
# 2. Add Authorized Redirect URI: http://localhost:8080/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# Google Gemini AI Companion (Kiki) Configuration
# Get your Gemini API Key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

