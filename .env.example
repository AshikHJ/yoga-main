# KI.AI Production & Development Environment Configuration

# Razorpay Payment Credentials (India SaaS Default)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Payment Mode: 'test' for simulation and local sandbox, 'live' for production
PAYMENT_MODE=test

# Application Host & Security
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081,http://127.0.0.1:8080,http://127.0.0.1:8081
SECRET_KEY=ki_ai_production_secret_key_change_in_live

# Optional Demo Mode override
KI_AI_DEMO_MODE=true
